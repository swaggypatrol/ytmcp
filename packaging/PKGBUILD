# Maintainer: YTMcp contributors <noreply@ytmcp.invalid>
#
# Reproducible build of YTMcp from a pinned git commit.
# Build through tools/package/build-package.sh, which sets YTMCP_REPO and
# YTMCP_COMMIT (the commit must be clean and committed) and runs makepkg.

pkgname=ytmcp
pkgver=1.3.0
pkgrel=1
pkgdesc="Native Wayland music player shell for the official YouTube Music web player (Electron + Rust)"
arch=('x86_64')
url="https://github.com/swaggypatrol/ytmcp"
license=('MIT')
# The project was called YTM Glass (package ytm-glass) up to 1.0.0; this package takes its place.
conflicts=('ytm-glass')
replaces=('ytm-glass')
_electron=45.4.1
_repo="${YTMCP_REPO:?set YTMCP_REPO to the git repository path}"
_commit="${YTMCP_COMMIT:?set YTMCP_COMMIT to a full commit sha}"

# Shared libraries resolved from the ELF NEEDED entries of electron, libffmpeg,
# chrome_crashpad_handler and both Rust executables (see docs/building.md).
depends=(
  'alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'glibc' 'gtk3'
  'libcups' 'libgcc' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext'
  'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango'
  'systemd-libs' 'hicolor-icon-theme' 'xdg-utils'
)
# pnpm must be the version pinned in package.json (packageManager); it is
# checked in prepare() because the repo version differs from Arch's pnpm.
makedepends=('git' 'rust' 'cargo' 'nodejs')
_pnpm=11.21.0
optdepends=(
  'kwallet: encrypted storage of the player profile secrets on KDE'
  'ttf-lxgw-wenkai: preferred CJK UI font'
  'noto-fonts-cjk: CJK fallback font'
  'pipewire-pulse: audio output'
)
options=('!strip' '!debug' '!lto')
source=(
  "ytmcp::git+file://${_repo}#commit=${_commit}"
  "electron-v${_electron}-linux-x64.zip::https://github.com/electron/electron/releases/download/v${_electron}/electron-v${_electron}-linux-x64.zip"
)
noextract=("electron-v${_electron}-linux-x64.zip")
sha256sums=('SKIP'
            'e1d077c7a087d7e344350ea0c5cd2b7dc5af3d9bf7979474f38e0fc1a560b875')

prepare() {
  cd ytmcp
  [[ "$(pnpm --version)" == "${_pnpm}" ]] || { echo "need pnpm ${_pnpm} in PATH" >&2; return 1; }
  local node_version rust_version
  node_version="$(node -p "require('./package.json').engines.node")"
  rust_version="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)"
  [[ "$(node --version)" == "v${node_version}" ]] || { echo "need Node.js ${node_version} in PATH" >&2; return 1; }
  [[ "$(rustc --version | cut -d' ' -f2)" == "${rust_version}" ]] || { echo "need Rust ${rust_version} in PATH" >&2; return 1; }
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
  ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile
  rm -rf "${srcdir}/electron"
  mkdir -p "${srcdir}/electron"
  bsdtar -xf "${srcdir}/electron-v${_electron}-linux-x64.zip" -C "${srcdir}/electron"
  [[ "$(tr -d '[:space:]' < "${srcdir}/electron/version")" == "${_electron}" ]]
}

build() {
  cd ytmcp
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --release --frozen -p ytm-daemon -p ytmcp
  pnpm --filter @ytmcp/bridge run build
  pnpm --filter @ytmcp/ui run build
  pnpm --filter @ytmcp/desktop run build
  node tools/package/gen-notices.mjs > "${srcdir}/THIRD_PARTY_NOTICES.md"
  {
    printf 'source_commit=%s\n' "$(git rev-parse HEAD)"
    printf 'package=%s-%s-%s-x86_64\n' "$pkgname" "$pkgver" "$pkgrel"
    printf 'app_license=%s\n' "${license[0]}"
    printf 'build_node=%s\nbuild_pnpm=%s\n' "$(node --version)" "$(pnpm --version)"
    rustc --version
    cargo --version
    printf '\nBundled Electron runtime:\n'
    ELECTRON_RUN_AS_NODE=1 "${srcdir}/electron/electron" -p 'JSON.stringify(process.versions, null, 2)'
    printf '\nLock and identity SHA-256:\n'
    sha256sum Cargo.lock pnpm-lock.yaml config/app-identity.json
    printf '\nShipped Rust binaries SHA-256:\n'
    ( cd "${CARGO_TARGET_DIR}/release" && sha256sum ytm-daemon ytmcp )
    printf '\nDirect and optional system dependencies on the build host:\n'
    local dependency name
    for dependency in "${depends[@]}" "${optdepends[@]}"; do
      name="${dependency%%:*}"
      if LC_ALL=C pacman -Q "$name" >/dev/null 2>&1; then
        LC_ALL=C pacman -Qi "$name" | awk -F ' *: ' '$1 ~ /^(Name|Version|Licenses) *$/ {print}'
      else
        printf '%s (absent from build host)\n' "$name"
      fi
      printf '\n'
    done
  } > "${srcdir}/BUILD-MANIFEST.txt"
}

check() {
  cd ytmcp
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo test --frozen --workspace
  pnpm -r test
}

package() {
  local root="${pkgdir}/opt/ytmcp"
  local res="${root}/resources"

  install -dm755 "${root}"
  cp -a "${srcdir}/electron/." "${root}/"
  rm -f "${res}/default_app.asar"
  mv "${root}/electron" "${root}/ytmcp-player"
  # Chromium uses the unprivileged user-namespace sandbox; no setuid helper.
  rm -f "${root}/chrome-sandbox"

  cd ytmcp
  install -Dm755 "${srcdir}/target/release/ytm-daemon" "${res}/bin/ytm-daemon"
  install -Dm644 packaging/app-package.json "${res}/app/package.json"
  cp -a apps/desktop/dist "${res}/app/dist"
  cp -a ui/dist "${res}/ui-dist"
  cp -a bridge/dist "${res}/bridge-dist"
  install -Dm644 config/app-identity.json "${res}/config/app-identity.json"
  install -Dm644 /dev/null "${res}/config/mcp-background-v1"

  install -Dm755 packaging/ytmcp-player.sh "${pkgdir}/usr/bin/ytmcp-player"
  install -Dm755 "${srcdir}/target/release/ytmcp" "${pkgdir}/usr/bin/ytmcp"
  install -Dm644 packaging/local.ytmcp.Desktop.desktop \
    "${pkgdir}/usr/share/applications/local.ytmcp.Desktop.desktop"
  local size
  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/ytmcp-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/local.ytmcp.Desktop.png"
  done
  install -Dm644 "${srcdir}/BUILD-MANIFEST.txt" "${pkgdir}/usr/share/doc/${pkgname}/BUILD-MANIFEST.txt"

  local lic="${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 packaging/LICENSE "${lic}/LICENSE"
  install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" "${lic}/THIRD_PARTY_NOTICES.md"
  install -Dm644 "${srcdir}/electron/LICENSE" "${lic}/electron/LICENSE"
  install -Dm644 "${srcdir}/electron/LICENSES.chromium.html" "${lic}/electron/LICENSES.chromium.html"
}
